<!DOCTYPE html>
<html lang="fr" data-theme="{{
  request.plainCookie('app_theme', {
    defaultValue: 'light',
    encoded: false,
  })
}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Événements — Event Manager</title>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="events-page">
  <header class="events-header">
    <a href="{{ route('home') }}" class="events-brand">
      <span class="events-brand__mark">✦</span>
      <span>Event Manager</span>
    </a>
    <div class="events-header__actions">
      @!themeToggle()
      @if(auth.user)
        @link({ route: 'dashboard', class: 'btn btn--secondary btn--sm' })
          Tableau de bord
        @end
      @else
        @link({ route: 'session.create', class: 'btn btn--ghost btn--sm' })
          Se connecter
        @end
      @end
    </div>
  </header>
  <main class="events-main">
    @include('partials/flash_alerts')
    <section class="events-hero">
      <div>
        <span class="tag events-kicker">Agenda communautaire</span>
        <h1>Des moments à<br><em>ne pas manquer.</em></h1>
        <p>Découvrez les prochains rendez-vous et trouvez l’événement qui vous ressemble.</p>
      </div>
      @if(auth.user)
        @link({ route: 'events.create', class: 'btn btn--primary events-hero__button' })
          <span class="events-button-icon">+</span> Créer un événement
        @end
      @else
        @link({ route: 'session.create', class: 'btn btn--primary events-hero__button' })
          Rejoindre Event Manager <span>→</span>
        @end
      @end
    </section>
    <div class="events-list-heading">
      <div>
        <span class="tag">À l’affiche</span>
        <h2>Les prochains événements</h2>
      </div>
      <span class="events-count">{{ eventCards.length }} rendez-vous</span>
    </div>
    <form method="GET" action="{{ route('events.index') }}" class="events-filters">
      <div class="events-filter events-filter--search">
        <label for="search">Rechercher</label>
        <input
          id="search"
          type="search"
          name="search"
          value="{{ search || '' }}"
          placeholder="Titre, lieu, catégorie..."
        >
      </div>
      <div class="events-filter">
        <label for="category">Catégorie</label>
        <select id="category" name="category">
          <option value="">Toutes les catégories</option>
          @each(category in categories)
            <option value="{{ category }}" {{ selectedCategory === category ? 'selected' : '' }}>
              {{ category }}
            </option>
          @end
        </select>
      </div>
      <div class="events-filter">
        <label for="date">Date</label>
        <input id="date" type="date" name="date" value="{{ selectedDate || '' }}">
      </div>
      <button type="submit" class="btn btn--secondary btn--sm">Filtrer</button>
      @if(search || selectedCategory || selectedDate)
        @link({ route: 'events.index', class: 'btn btn--ghost btn--sm' })
          Réinitialiser
        @end
      @endif
    </form>
    @if(eventCards.length === 0)
      <div class="events-empty">
        <div class="events-empty__icon">✦</div>
        <h3>Aucun événement trouvé</h3>
        <p>Modifiez vos filtres ou soyez le premier à proposer une nouvelle expérience.</p>
        @if(auth.user)
          @link({ route: 'events.create', class: 'btn btn--secondary' })
            Proposer un événement
          @end
        @end
      </div>
    @else
      <div class="events-grid">
        @each(card in eventCards)
          @let(event = card.event)
          <article class="event-card">
            <div class="event-card__top">
              <span class="event-card__category">{{ event.category }}</span>
              <span class="event-card__arrow">↗</span>
            </div>
            <h3>{{ event.title }}</h3>
            <p class="event-card__description">{{ event.description || 'Une expérience à découvrir et à partager.' }}</p>
            <div class="event-card__details">
              <span><strong>◷</strong> {{ event.eventDate }}</span>
              <span><strong>⌖</strong> {{ event.location }}</span>
            </div>
            <div class="event-card__footer">
              <span>{{ card.registrationCount }} / {{ event.maxCapacity }} participant{{ card.registrationCount > 1 ? 's' : '' }}</span>
              <span class="event-card__line"></span>
            </div>
            @if(card.participantNames.length > 0)
              <div class="event-card__participants">
                <span class="event-card__participants-label">Inscrits</span>
                <span>{{ card.participantNames.join(', ') }}</span>
              </div>
            @endif
            @if(auth.user && auth.user.isAdmin)
              <div class="event-card__admin-actions">
                @each(participant in card.participants)
                  @form({
                    route: 'events.registrations.destroy',
                    routeParams: { id: event.id, registrationId: participant.id },
                    method: 'POST'
                  })
                    <button type="submit" class="btn btn--ghost btn--sm">
                      Retirer {{ participant.name }}
                    </button>
                  @end
                @end
                @form({ route: 'events.destroy', routeParams: { id: event.id }, method: 'POST' })
                  <button type="submit" class="btn btn--ghost btn--sm">Supprimer l’événement</button>
                @end
              </div>
            @endif
            @if(auth.user)
              @if(card.isRegistered)
                @form({ route: 'events.unregister', routeParams: { id: event.id }, method: 'POST' })
                  <button type="submit" class="btn btn--secondary btn--sm event-card__registration">Se désinscrire</button>
                @end
              @elseif(card.registrationCount >= event.maxCapacity)
                <span class="event-card__registration event-card__registration--full">Événement complet</span>
              @else
                @form({ route: 'events.register', routeParams: { id: event.id }, method: 'POST' })
                  <button type="submit" class="btn btn--secondary btn--sm event-card__registration">S’inscrire</button>
                @end
              @end
            @else
              @link({ route: 'session.create', class: 'btn btn--secondary btn--sm event-card__registration' })
                Se connecter pour s’inscrire
              @end
            @end
          </article>
        @end
      </div>
    @endif
  </main>
</body>
</html>
