@layouts.marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: var(--ok);">
          <span class="dot"></span>
          Evently est prêt
        </span>
      </div>
      <div class="pc-lead">Des expériences <em>à partager.</em></div>
      <p class="pc-para">
        Créez, découvrez et partagez les événements qui rendent chaque semaine un peu plus spéciale.
      </p>
      <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px;">
        @link({ route: 'events.index', class: 'btn btn--primary' })
          @svg('lucide:calendar-days', { width: 16, height: 16 })
          Voir les événements
        @end
        @if(!auth.user)
          @link({ route: 'new_account.create', class: 'btn btn--secondary' })
            Créer un compte
          @end
        @end
      </div>
    </article>
  </div>
@end
