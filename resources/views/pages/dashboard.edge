@layouts.app({ title: 'Tableau de bord' })
  @page()
    <div class="empty">
      <div class="empty__mark">
        @svg('lucide:calendar-days', { width: 22, height: 22 })
      </div>
      <h1>Votre tableau de bord</h1>
      <p>
        Retrouvez vos événements et accédez rapidement à l’agenda de la communauté.
      </p>
      @link({ route: 'events.index', class: 'btn btn--primary events-access-button' })
        @svg('lucide:calendar-days', { width: 16, height: 16 })
        Voir les événements
      @end
    </div>
  @end
@end
