@marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: var(--subtle);">
          <span class="dot"></span>
          404
        </span>
      </div>
      <div class="pc-lead"><span>Page introuvable.</span> <em>Cette route n’existe pas encore.</em></div>
      <p class="pc-para">Vérifie l’adresse ou retourne à l’accueil.</p>
      @link({ route: 'home', class: 'btn btn--primary', style: 'margin-top: 20px;' })
        Retour à l’accueil
      @end
    </article>
  </div>
@end
