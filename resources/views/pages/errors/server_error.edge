@marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: #c0392b;">
          <span class="dot"></span>
          {{ error.code || 500 }}
        </span>
      </div>
      <div class="pc-lead"><span>Une erreur est survenue.</span> <em>Le serveur a rencontré un problème.</em></div>
      <p class="pc-para">Réessaie dans quelques instants ou retourne à l’accueil.</p>
      @link({ route: 'home', class: 'btn btn--primary', style: 'margin-top: 20px;' })
        Retour à l’accueil
      @end
    </article>
  </div>
@end
